      "cell_type": "code",
      "execution_count": 7,
      "id": "33125d3b",
      "metadata": {
        "id": "33125d3b"
      },
      "outputs": [],
      "source": [
        "def vectorize_data(train_texts, test_texts, ngram_range, max_features, min_df):\n",
        "    # Creamos el vectorizer TF-IDF con los hiperparámetros recibidos:\n",
        "    # ngram_range controla si tomamos solo unigramas o también bigramas,\n",
        "    # max_features limita el tamaño del vocabulario a los términos más frecuentes,\n",
        "    # y min_df descarta términos que aparecen en muy pocos documentos.\n",
        "    vectorizer = TfidfVectorizer(ngram_range=ngram_range, max_features=max_features, min_df=min_df)\n",
        "\n",
        "    # Ajustamos (fit) el vectorizer SOLO sobre train (para no filtrar información del test set)\n",
        "    # y con ese mismo vocabulario/idf transformamos tanto train como test\n",
        "    X_train = vectorizer.fit_transform(train_texts)\n",
        "    X_test = vectorizer.transform(test_texts)\n",
        "    return X_train, X_test, vectorizer\n"
      ]
    },
