        "## 8.1 Dinámica de entrenamiento en distintos casos\n",
        "\n",
        "Hasta acá cada configuración se entrenó pocas épocas. Para entender la **dinámica** (cómo evolucionan loss y accuracy) y los **tiempos de convergencia**, entrenamos varias configuraciones durante 20 épocas, con las siguientes reglas para que la comparación sea justa:\n",
        "\n",
        "- Misma semilla (`torch.manual_seed`) y misma partición train/validación (80/20 estratificada del train) en todos los casos. **No se usa el test** para comparar.\n",
        "- Se mide el **tiempo de reloj por época** y el acumulado (`cum_time`).\n",
        "- **Experimento A:** learning rate (`1e-3`, `1e-2`, `1e-1`, `5e-1`) x batch size (`32`, `256`), con el mejor preprocesamiento de Optuna.\n",
        "- **Experimento B:** distintos preprocesamientos (baseline, solo stopwords, stemming, lematización, mejor de Optuna) con el mejor `lr` y `batch_size`."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 29,
      "id": "b9b0fd31",
      "metadata": {
        "id": "b9b0fd31"
      },
      "outputs": [],
      "source": [
        "import time\n",
        "\n",
        "EPOCHS_DYN = 20   # epocas para estudiar la dinamica (mas que las 5 de Optuna, para ver sobreajuste)\n",
        "\n",
        "\n",
        "def train_softmax_model_timed(model, train_loader, val_loader, optimizer, epochs):\n",
        "    \"\"\"Igual que train_softmax_model (misma logica de entrenamiento/validacion) pero:\n",
        "    - registra el tiempo de cada epoca (epoch_time) y el acumulado (cum_time)\n",
        "    - no imprime ni loguea a MLflow/TensorBoard, para poder correr muchas configuraciones rapido.\"\"\"\n",
        "    model.to(device)\n",
        "    criterion = nn.CrossEntropyLoss()\n",
        "    hist = {\"train_loss\": [], \"val_loss\": [], \"train_acc\": [], \"val_acc\": [], \"epoch_time\": [], \"cum_time\": []}\n",
        "    t_start = time.time()\n",
        "    for epoch in range(epochs):\n",
        "        t_ep = time.time()\n",
        "        # ---- entrenamiento ----\n",
        "        model.train()\n",
        "        run_loss, correct, total = 0.0, 0, 0\n",
        "        for xb, yb in train_loader:\n",
        "            xb, yb = xb.to(device), yb.to(device)\n",
        "            optimizer.zero_grad()\n",
        "            logits = model(xb)\n",
        "            loss = criterion(logits, yb)\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "            run_loss += loss.item() * xb.size(0)\n",
        "            correct += (logits.argmax(1) == yb).sum().item()\n",
        "            total += xb.size(0)\n",
        "        hist[\"train_loss\"].append(run_loss / total)\n",
        "        hist[\"train_acc\"].append(correct / total)\n",
        "        # ---- validacion ----\n",
        "        model.eval()\n",
        "        run_loss, correct, total = 0.0, 0, 0\n",
        "        with torch.no_grad():\n",
        "            for xb, yb in val_loader:\n",
        "                xb, yb = xb.to(device), yb.to(device)\n",
        "                logits = model(xb)\n",
        "                run_loss += criterion(logits, yb).item() * xb.size(0)\n",
        "                correct += (logits.argmax(1) == yb).sum().item()\n",
        "                total += xb.size(0)\n",
        "        hist[\"val_loss\"].append(run_loss / total)\n",
        "        hist[\"val_acc\"].append(correct / total)\n",
        "        hist[\"epoch_time\"].append(time.time() - t_ep)\n",
        "        hist[\"cum_time\"].append(time.time() - t_start)\n",
        "    return hist\n",
        "\n",
        "\n",
        "def prepare_split(remove_sw, norm, ngram, max_features, min_df):\n",
        "    \"\"\"Toma el texto preprocesado (cache), separa train/val como en Optuna, vectoriza y pasa a tensores.\"\"\"\n",
        "    texts, _ = preprocessed_cache[(remove_sw, norm)]\n",
        "    tr_t, val_t, tr_y, val_y = train_test_split(\n",
        "        texts, newsgroups_train.target, test_size=0.2, random_state=SEED, stratify=newsgroups_train.target)\n",
        "    t0 = time.time()\n",
        "    X_tr, X_val, _ = vectorize_data(tr_t, val_t, ngram, max_features, min_df)\n",
        "    vec_time = time.time() - t0\n",
        "    return to_tensor_dataset(X_tr, tr_y), to_tensor_dataset(X_val, val_y), vec_time\n",
        "\n",
        "\n",
        "def run_config(train_ds, val_ds, lr, batch_size, epochs=EPOCHS_DYN):\n",
        "    \"\"\"Entrena un SoftmaxRegression desde cero con la semilla fija y devuelve el historial con tiempos.\"\"\"\n",
        "    torch.manual_seed(SEED)\n",
        "    tr_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True)\n",
        "    va_loader = DataLoader(val_ds, batch_size=batch_size, shuffle=False)\n",
        "    model = SoftmaxRegression(input_dim=train_ds.tensors[0].shape[1], num_classes=NUM_CLASSES)\n",
        "    opt = optim.Adam(model.parameters(), lr=lr)\n",
        "    return train_softmax_model_timed(model, tr_loader, va_loader, opt, epochs)\n",
        "\n",
        "\n",
        "def plot_dynamics(results, title, styles=None):\n",
        "    \"\"\"4 graficos: train_loss, val_loss, val_acc por epoca y val_acc vs tiempo acumulado.\"\"\"\n",
        "    fig, axes = plt.subplots(2, 2, figsize=(15, 9))\n",
        "    for i, (name, h) in enumerate(results.items()):\n",
        "        kw = (styles or {}).get(name, {\"color\": f\"C{i}\"})\n",
        "        ep = range(1, len(h[\"val_acc\"]) + 1)\n",
        "        axes[0, 0].plot(ep, h[\"train_loss\"], label=name, **kw)\n",
        "        axes[0, 1].plot(ep, h[\"val_loss\"], label=name, **kw)\n",
        "        axes[1, 0].plot(ep, h[\"val_acc\"], label=name, **kw)\n",
        "        axes[1, 1].plot(h[\"cum_time\"], h[\"val_acc\"], label=name, **kw)\n",
        "    axes[0, 0].set_title(\"Loss de entrenamiento\"); axes[0, 1].set_title(\"Loss de validacion\")\n",
        "    axes[1, 0].set_title(\"Accuracy de validacion por epoca\"); axes[1, 1].set_title(\"Accuracy de validacion vs tiempo (s)\")\n",
        "    for a in axes[:, 0]: a.set_xlabel(\"epoca\")\n",
        "    axes[0, 1].set_xlabel(\"epoca\"); axes[1, 1].set_xlabel(\"tiempo acumulado (s)\")\n",
        "    axes[0, 0].set_yscale(\"log\")\n",
        "    axes[0, 0].legend(fontsize=8)\n",
        "    plt.suptitle(title)\n",
        "    plt.tight_layout()\n",
        "    plt.show()"
      ]
    },
