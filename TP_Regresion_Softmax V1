        "def convergence_table(results, frac=0.95):\n",
        "    \"\"\"Tabla resumen de convergencia y sobreajuste para un dict {nombre: historial}.\"\"\"\n",
        "    global_best = max(max(h[\"val_acc\"]) for h in results.values())\n",
        "    target = frac * global_best\n",
        "    rows = []\n",
        "    for name, h in results.items():\n",
        "        va, vl, cum = np.array(h[\"val_acc\"]), np.array(h[\"val_loss\"]), np.array(h[\"cum_time\"])\n",
        "        hit = np.where(va >= target)[0]\n",
        "        best_ep_loss = int(np.argmin(vl))\n",
        "        rows.append({\n",
        "            \"config\": name,\n",
        "            \"best_val_acc\": va.max(),\n",
        "            \"ep_best_acc\": int(np.argmax(va)) + 1,\n",
        "            f\"ep_a_{int(frac*100)}%\": int(hit[0]) + 1 if len(hit) else np.nan,\n",
        "            f\"seg_a_{int(frac*100)}%\": cum[hit[0]] if len(hit) else np.nan,\n",
        "            \"ep_min_val_loss\": best_ep_loss + 1,\n",
        "            \"min_val_loss\": vl.min(),\n",
        "            \"val_loss_final\": vl[-1],\n",
        "            \"suba_val_loss_%\": 100 * (vl[-1] / vl.min() - 1),\n",
        "            \"brecha_final(train-val)\": h[\"train_acc\"][-1] - va[-1],\n",
        "            \"seg/epoca\": np.mean(h[\"epoch_time\"]),\n",
